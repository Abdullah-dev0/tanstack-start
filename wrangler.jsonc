// ☁️ Cloudflare Workers settings.
// 📖 https://developers.cloudflare.com/workers/framework-guides/web-apps/tanstack-start/
// 📖 https://tanstack.com/start/latest/docs/framework/react/guide/hosting
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-notes", // → my-notes.<your-subdomain>.workers.dev
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"], // lets Node libraries (pg, better-auth) work
  "main": "@tanstack/react-start/server-entry",
  "observability": { "enabled": true }, // logs in the Cloudflare dashboard

  // 🐘 Postgres through Hyperdrive (fast connection layer to your database)
  // 📖 https://developers.cloudflare.com/hyperdrive/examples/connect-to-postgres/postgres-drivers-and-libraries/drizzle-orm/
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // ⏳ Placeholder — replaced with the real id after `wrangler hyperdrive create`
      "id": "00000000000000000000000000000000",
      // 💻 Local dev: talk straight to the Docker Postgres (same as docker-compose.yml)
      // 📖 https://developers.cloudflare.com/hyperdrive/configuration/local-development/
      "localConnectionString": "postgresql://postgres:postgres@localhost:5432/notes",
    },
  ],
}
